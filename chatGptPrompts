CREATE PROCEDURE [dbo].[usp_Get_File_Import_Content_Alfa_For_Export]
    @P__FileImportId BIGINT,
    @P__Error NVARCHAR(4000) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    SET @P__Error = '';

    -- Check if FileImport exists
    IF NOT EXISTS (SELECT 1 FROM [dbo].[t_File_Import] WHERE Id = @P__FileImportId)
    BEGIN
        SET @P__Error = CONCAT('File Import with Id ', @P__FileImportId, ' does not exist.');
        RETURN;
    END

    -- Get all data except the last 4 audit fields
    SELECT
        [BankCode],
        [BankName],
        [BankBranch],
        [BankAccountNumber],
        [CustomerName],
        [PrimaryAccountNumber],
        [MsisdnPrimaryContact],
        [AccountBalance],
        [InvoiceDate],
        [AmountPaid],
        [SayrafaRate]
    FROM [dbo].[t_File_Import_Content_Alfa]
    WHERE FileImportId = @P__FileImportId
    ORDER BY Id;
END
GO

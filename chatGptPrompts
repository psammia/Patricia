}
5. Update PDF Generation Methods
Update all three PDF generation methods to use the user parameter:
csharpprivate async Task<byte[]> GenerateCustomerDocPDF(
    List<ContainerFileDto> files, 
    string containerCode, 
    string entity, 
    string user)
{
    try
    {
        var archivingPeriod = files.First().ArchivingPeriod;
        bool unlimited = archivingPeriod == -1;
        DateTime destructionDate = DateTime.Now.AddYears(archivingPeriod);

        // Group files by DocumentType and collect customer IDs
        var customerFiles = files
            .GroupBy(f => f.FileName)
            .Select(g => new
            {
                DocumentType = g.Key,
                Id = g.Select(f => f.CustomerId?.ToString()).Where(id => id != null).ToList()
            })
            .ToList();

        var request = new
        {
            DestructionDate = unlimited ? "Unlimited" : destructionDate.ToString("dd/MM/yyyy"),
            ContainerID = containerCode,
            Entity = entity,
            User = user,  // Use the retrieved user
            CustomerFiles = customerFiles,
            CreationDate = DateTime.Now.ToString("dd/MM/yyyy")
        };

        _logger.LogInformation($"Sending Customer PDF request for container {containerCode} with user {user}");

        var response = await _httpClient.PostAsJsonAsync(
            $"{_pdfServiceBaseUrl}GenerateCustomerDocPDFForArchive", 
            request);

        if (!response.IsSuccessStatusCode)
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            _logger.LogError($"PDF service error: {errorContent}");
            return null;
        }

        return await response.Content.ReadAsByteArrayAsync();
    }
    catch (Exception ex)
    {
        _logger.LogError(ex, $"Error generating customer PDF for container {containerCode}");
        return null;
    }
}


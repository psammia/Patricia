namespace BLL
{
    public partial class Bll
    {
        #region Get Application Files
        public async Task<Get_ApplicationFiles_Response> Get_ApplicationFiles(Get_ApplicationFiles_Request request)
        {
            DapperDal dal = new DapperDal(_globalSettings.ConnString);
            DynamicParameters parameters = new DynamicParameters();
            
            parameters.Add("P__CorrelationId", request.CorrelationId);
            parameters.Add("P__External_Id", request.External_Id);

            // Execute stored procedure that returns multiple result sets
            using var multi = await dal.ExecuteQueryMultipleAsync(
                "usp_GetApplicationFiles",
                parameters,
                CommandType.StoredProcedure);

            // First result set: Application data
            Application? application = (await multi.ReadAsync<Application>()).FirstOrDefault();

            // Second result set: Files data
            IEnumerable<App_Files_Db> filesDb = await multi.ReadAsync<App_Files_Db>();

            // Convert byte[] to base64 for output
            List<App_Files_Output> filesOutput = filesDb.Select(f => new App_Files_Output
            {
                Id = f.Id,
                App_Id = f.App_Id,
                File_Name = f.File_Name,
                File_Type = f.File_Type,
                File_Size = f.File_Size,
                File_Data_Base64 = Convert.ToBase64String(f.File_Data),
                CreatedDate = f.CreatedDate
            }).ToList();

            Get_ApplicationFiles_Response response = new Get_ApplicationFiles_Response
            {
                BaseResponse = new BaseResponse
                {
                    CorrelationId = request.BaseRequest.CorrelationId,
                    ReturnCode = "200",
                    ReturnDescription = "Success"
                },
                Application = application,
                Files = filesOutput
            };

            return response;
        }
        #endregion
    }
}


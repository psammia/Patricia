csharp#region MergeOriginalDataWithT24PaymentDetails
private List<AlfaClient> MergeOriginalDataWithT24PaymentDetails(
    List<AlfaFileImportContent> originalData,
    List<T24File> t24FileRecords)
{
    List<AlfaClient> mergedClients = new List<AlfaClient>();

    // Create a dictionary of T24 data keyed by REFERENCE (MSISDN) for quick lookup
    Dictionary<string, T24File> t24DataByReference = t24FileRecords.ToDictionary(
        t24 => t24.REFERENCE.Trim(),
        t24 => t24
    );

    foreach (var originalRecord in originalData)
    {
        string msisdn = originalRecord.MsisdnPrimaryContact.Trim();

        // Find matching T24 record by REFERENCE (which contains MSISDN)
        if (!t24DataByReference.TryGetValue(msisdn, out var t24Record))
        {
            throw new SGBLBadRequestException(
                $"MSISDN {msisdn} not found in T24 file. All original records must be present in T24 file.");
        }

        // Parse AMOUNT from T24 (this is the account balance in T24 format)
        if (!decimal.TryParse(t24Record.AMOUNT, out decimal amountT24))
        {
            throw new SGBLBadRequestException(
                $"Invalid AMOUNT for MSISDN {msisdn}: {t24Record.AMOUNT}");
        }
        decimal amount = amountT24 / 1000;  // Convert from T24 format

        // Determine AmountPaid based on PAYMENT_DETAILS
        decimal amountPaid;
        if (string.IsNullOrWhiteSpace(t24Record.PAYMENT_DETAILS))
        {
            // If PAYMENT_DETAILS is empty → Use AMOUNT value
            amountPaid = amount;
        }
        else
        {
            // If PAYMENT_DETAILS has a value → Parse it
            if (!decimal.TryParse(t24Record.PAYMENT_DETAILS, out decimal paymentDetailsT24))
            {
                throw new SGBLBadRequestException(
                    $"Invalid PAYMENT_DETAILS for MSISDN {msisdn}: {t24Record.PAYMENT_DETAILS}");
            }
            amountPaid = paymentDetailsT24 / 1000;  // Convert from T24 format
        }

        // Keep original SayrafaRate (T24 file doesn't have this field)
        decimal sayrafaRate = originalRecord.SayrafaRate ?? 0;

        // Create merged AlfaClient with original data + T24 payment details
        mergedClients.Add(new AlfaClient
        {
            BankCode = originalRecord.BankCode,
            BankName = originalRecord.BankName,
            BankBranch = originalRecord.BankBranch,
            BankAccountNumber = originalRecord.BankAccountNumber,
            CustomerName = originalRecord.CustomerName,
            PrimaryAccountNumber = originalRecord.PrimaryAccountNumber,
            MsisdnPrimaryContact = originalRecord.MsisdnPrimaryContact,
            AccountBalance = originalRecord.AccountBalance,  // Keep original
            InvoiceDate = originalRecord.InvoiceDate,        // Keep original
            AmountPaid = amountPaid,                         // From T24
            SayrafaRate = sayrafaRate                        // Keep original
        });
    }

    return mergedClients;
}
#endregion

#region UpdateAlfaClientsUsingStoredProcedure
private async Task UpdateAlfaClientsUsingStoredProcedure(
    long fileImportId, 
    List<AlfaClient> alfaClients, 
    string userName)
{
    if (alfaClients == null || alfaClients.Count == 0)
    {
        throw new SGBLBadRequestException("No data provided to update.");
    }

    DAL.DapperDal dal = new DapperDal(_globalSettings.ConnString);

    DynamicParameters parameters = new DynamicParameters();

    parameters.Add("@NewFileImportId", fileImportId);
    parameters.Add("@P__FileImportContentAlfa", GetFileImportContentAlfaDt(alfaClients).AsTableValuedParameter());
    parameters.Add("@P__User", userName);
    parameters.Add("@P__Error", direction: ParameterDirection.Output, size: 4000);

    _ = await dal.ExecuteQueryAsync<dynamic>(
        "usp_Edit_File_Import_Content_Alfa",
        parameters,
        CommandType.StoredProcedure,
        DapperDal.CommandDirection.Update);

    string errorMessage = parameters.Get<string>("@P__Error");

    if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        throw new SGBLBadRequestException(errorMessage);
    }
}

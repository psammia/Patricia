4. Update PDFGeneratorBackfillService
Update the GeneratePDFForContainer method:
csharppublic async Task<bool> GeneratePDFForContainer(string containerCode)
{
    try
    {
        _logger.LogInformation($"Starting PDF generation for container: {containerCode}");

        // Get container data
        var containerData = await GetContainerDataForPDF(containerCode);
        if (containerData == null || !containerData.Any())
        {
            _logger.LogWarning($"No data found for container: {containerCode}");
            return false;
        }

        var firstFile = containerData.First();
        string documentType = firstFile.DocumentType;

        // Get the user who sent the container (BoxSentBy or AlternaSystem)
        var sentByInfo = GetContainerSentByUserForPDF(containerCode);
        string user = sentByInfo?.SentByUser ?? "AlternaSystem";
        
        _logger.LogInformation($"Using user '{user}' for PDF generation of container {containerCode}");

        // Determine entity for PDF generation
        string entity = GetEntityForPDF(firstFile.CompanyCode);

        // Generate PDF based on document type
        byte[] pdfBytes = null;
        string apiMethod = string.Empty;

        if (documentType == "CUSTOMER")
        {
            pdfBytes = await GenerateCustomerDocPDF(containerData, containerCode, entity, user);
            apiMethod = "GenerateCustomerDocPDFForArchive";
        }
        else if (documentType == "BRANCH")
        {
            pdfBytes = await GenerateBranchDocPDF(containerData, containerCode, entity, user);
            apiMethod = "GenerateBranchDocPDFForArchive";
        }
        else if (documentType == "ENTITY")
        {
            pdfBytes = await GenerateEntityDocPDF(containerData, containerCode, entity, user);
            apiMethod = "GenerateEntityDocPDFForArchive";
        }

        if (pdfBytes == null || pdfBytes.Length == 0)
        {
            _logger.LogError($"Failed to generate PDF for container: {containerCode}");
            return false;
        }

        // Store PDF in database
        bool stored = await StorePDFInDatabase(pdfBytes, containerCode, apiMethod, entity, user);
        
        if (stored)
        {
            _logger.LogInformation($"Successfully generated and stored PDF for container: {containerCode}");
        }
        
        return stored;
    }
    catch (Exception ex)
    {
        _logger.LogError(ex, $"Error generating PDF for container {containerCode}: {ex.Message}");
        return false;
    }
}

private ContainerSentByUserDto GetContainerSentByUserForPDF(string containerCode)
{
    using (var connection = new SqlConnection(_configuration.GetConnectionString("ArchiveConnection")))
    {
        var parameters = new DynamicParameters();
        parameters.Add("ContainerCode", containerCode);
        
        return connection.QueryFirstOrDefault<ContainerSentByUserDto>(
            "usp_GetContainerSentByUserForPDF",
            parameters,
            commandType: CommandType.StoredProcedure
        );

/*
USE [Alterna.OnBoarding]
GO

-- =====================================================================
-- Author:      Patricia Sammia
-- Create date: 03-10-2025
-- Description: Update Application Status by CorrelationId and External_Id
-- =====================================================================
CREATE OR ALTER PROCEDURE [dbo].[usp_UpdateApplicationStatus]
(
    @P__CorrelationId NVARCHAR(250),
    @P__External_Id NVARCHAR(10),
    @P__StatusId INT
)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @AppId BIGINT;

    BEGIN TRY
        -- Check if application exists
        SELECT @AppId = Id
        FROM dbo.t_Application
        WHERE CorrelationId = @P__CorrelationId
          AND External_Id = @P__External_Id;

        -- If application not found, return empty result
        IF @AppId IS NULL
        BEGIN
            SELECT 
                CAST(NULL AS BIGINT) AS Id,
                CAST(NULL AS NVARCHAR(250)) AS CorrelationId,
                CAST(NULL AS NVARCHAR(10)) AS External_Id,
                CAST(NULL AS INT) AS StatusId
            WHERE 1 = 0;
            RETURN;
        END

        -- Update the application status
        UPDATE dbo.t_Application
        SET 
            StatusId = @P__StatusId,
            LastModifiedBy = 'AlternaSysUser',
            LastModifiedDate = GETDATE()
        WHERE Id = @AppId;

        -- Return updated application
        SELECT 
            Id,
            CorrelationId,
            External_Id,
            StatusId
        FROM dbo.t_Application
        WHERE Id = @AppId;

    END TRY
    BEGIN CATCH
        DECLARE @ErrorMessage NVARCHAR(4000),
                @ErrorSeverity INT,
                @ErrorState INT;

        SELECT
            @ErrorMessage = ERROR_MESSAGE(),
            @ErrorSeverity = ERROR_SEVERITY(),
            @ErrorState = ERROR_STATE();

        RAISERROR (@ErrorMessage, @ErrorSeverity, @ErrorState);
    END CATCH
END
GO
*/


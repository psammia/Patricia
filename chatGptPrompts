6. Update StorePDFInDatabase Method
csharpprivate async Task<bool> StorePDFInDatabase(
    byte[] pdfBytes, 
    string containerCode, 
    string apiMethod, 
    string entity, 
    string user)
{
    try
    {
        using (var connection = new SqlConnection(_configuration.GetConnectionString("ArchiveConnection")))
        {
            await connection.OpenAsync();

            var parameters = new DynamicParameters();
            parameters.Add("@PDF", pdfBytes);
            parameters.Add("@Request", $"{{\"ContainerID\": \"{containerCode}\"}}");
            parameters.Add("@ApiMethod", apiMethod);
            parameters.Add("@BranchList", (string)null);
            parameters.Add("@Entity", entity);
            parameters.Add("@User", user);  // Pass the correct user

            await connection.ExecuteAsync(
                "usp_InsertPDF",
                parameters,
                commandType: CommandType.StoredProcedure
            );

            _logger.LogInformation($"PDF stored in database for container {containerCode} by user {user}");
            return true;
        }
    }
    catch (Exception ex)
    {
        _logger.LogError(ex, $"Error storing PDF in database for container {containerCode}");
        return false;
    }
}

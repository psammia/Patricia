CREATE PROCEDURE dbo.InsertIntoAllTables
    @InputData dbo.MyInputTableType READONLY
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @User NVARCHAR(50) = 'AlternaSysUser';
    DECLARE @Now DATETIME = GETDATE();

    BEGIN TRY
        BEGIN TRANSACTION;

        -- Table 1 Insert
        INSERT INTO Table1 (
            Var1, Var2, Var3, Var4, Var5, Var6, Var7, Var8, Var9, Var10,
            CreatedBy, CreatedDate, LastModifiedBy, LastModifiedDate
        )
        SELECT 
            Var1, Var2, Var3, Var4, Var5, Var6, Var7, Var8, Var9, Var10,
            @User, @Now, @User, @Now
        FROM @InputData;

        -- Repeat for other tables
        INSERT INTO Table2 (...) SELECT ... FROM @InputData;
        INSERT INTO Table3 (...) SELECT ... FROM @InputData;
        INSERT INTO Table4 (...) SELECT ... FROM @InputData;
        INSERT INTO Table5 (...) SELECT ... FROM @InputData;
        INSERT INTO Table6 (...) SELECT ... FROM @InputData;
        INSERT INTO Table7 (...) SELECT ... FROM @InputData;

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        ROLLBACK TRANSACTION;

        DECLARE @ErrMsg NVARCHAR(4000) = ERROR_MESSAGE();
        DECLARE @ErrSeverity INT = ERROR_SEVERITY();
        RAISERROR (@ErrMsg, @ErrSeverity, 1);
    END CATCH
END;

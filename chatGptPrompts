CREATE PROCEDURE [dbo].[usp_GetBoxSentByUser]
    @ContainerCode NVARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT TOP 1
        cs.CreatedBy AS BoxSentBy
    FROM [dbo].[t_ContainerStatus] cs
    INNER JOIN [dbo].[t_Container] c ON cs.ContainerId = c.ContainerID
    WHERE c.Code = @ContainerCode
      AND cs.StatusCode = 'SENT'
    ORDER BY cs.CreatedDate ASC;
END
GO
